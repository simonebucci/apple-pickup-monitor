<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.apple-pickup-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>PYTHON_PATH</string>
        <string>-u</string>
        <string>/Users/YOUR_USER/apple-pickup-monitor/check_iphone_duo.py</string>
        <string>--config</string>
        <string>/Users/YOUR_USER/apple-pickup-monitor/config.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USER/apple-pickup-monitor</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/apple-pickup-monitor/monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/apple-pickup-monitor/monitor-error.log</string>
</dict>
</plist>
